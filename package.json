{
  "name": "eira-plataforma",
  "private": true,
  "version": "3.0.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md,html,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md,html,yaml}\" --ignore-path .prettierignore",
    "demo:reset": "node apps/api/src/scripts/resetDemo.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
